{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "TV4 - Cong viec nhom",
      "request": "launch",
      "shortenCommandLine": "jarmanifest",
      "mainClass": "vn.ktd.taskhub.client.AccountDesktop"
    },
    {
      "type":"java",
      "name":"TV1 - Tai khoan va nhat ky",
      "request":"launch",
      "shortenCommandLine":"jarmanifest",
      "mainClass":"vn.ktd.taskhub.client.AccountDesktop"
    },
    {
      "type": "java",
      "name": "TV1 - Login Server",
      "envFile": "${workspaceFolder}/.env",
      "request": "launch",
      "console": "integratedTerminal",
      "shortenCommandLine": "jarmanifest",
      "mainClass": "vn.ktd.taskhub.server.ServerMain",
      "args": "--login"
    },
    {
      "type": "java",
      "name": "TV1 - Login Client",
      "request": "launch",
      "console": "integratedTerminal",
      "shortenCommandLine": "jarmanifest",
      "mainClass": "vn.ktd.taskhub.client.ClientMain",
      "args": "--login"
    },
    {
      "type": "java",
      "name": "TV1 - Kiem tra MySQL",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "shortenCommandLine": "jarmanifest",
      "mainClass": "vn.ktd.taskhub.server.database.DatabaseCheck"
    },
    {
      "type": "java",
      "name": "ServerMain",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "shortenCommandLine": "jarmanifest",
      "mainClass": "vn.ktd.taskhub.server.ServerMain"
    },
    {
      "type": "java",
      "name": "ClientMain",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "shortenCommandLine": "jarmanifest",
      "mainClass": "vn.ktd.taskhub.client.ClientMain"
    }
  ]
}



