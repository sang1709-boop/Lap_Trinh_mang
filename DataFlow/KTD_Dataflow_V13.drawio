<mxfile host="app.diagrams.net" version="24.0.0" pages="9"><diagram id="pg1" name="Mức 0 - Ngữ cảnh hệ thống"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="KTĐ TASK HUB / LUỒNG DỮ LIỆU" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#12785A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="400" height="20" as="geometry" /></mxCell><mxCell id="c3" value="Mức 0 / Ngữ cảnh hệ thống" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1B3A57;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1400" height="44" as="geometry" /></mxCell><mxCell id="c4" value="Khoa đối soát MSSV–email trường; bộ định thời gửi mốc hết hiệu lực và lịch quét. Tiến trình xác thực dùng D1 trước khi xử lý yêu cầu của người dùng." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1B3A57;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1400" height="24" as="geometry" /></mxCell><mxCell id="c5" value="Sinh viên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#5B6B7A;fontColor=#1B3A57;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="200" height="130" as="geometry" /></mxCell><mxCell id="c6" value="0&lt;br&gt;Quản lý hoạt động nhóm sinh viên" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F1FD;strokeColor=#3B5B7A;fontColor=#1B3A57;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="280" height="150" as="geometry" /></mxCell><mxCell id="c7" value="Dịch vụ email" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#5B6B7A;fontColor=#1B3A57;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1080" y="160" width="200" height="130" as="geometry" /></mxCell><mxCell id="c8"