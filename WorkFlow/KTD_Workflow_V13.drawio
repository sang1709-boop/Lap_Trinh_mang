vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="373" width="100" height="21" /></mxCell><mxCell id="e28" edge="1" parent="1" source="n3" target="b3" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e28l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="503" width="100" height="21" /></mxCell><mxCell id="e30" edge="1" parent="1" source="n4" target="b4" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e30l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="633" width="100" height="21" /></mxCell></root></mxGraphModel></diagram><diagram name="LĐ - Tạo và phân công việc" id="wf3"><mxGraphModel pageWidth="1080" pageHeight="1175" page="1" pageScale="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Tạo và phân công việc" style="text;align=left;fontSize=28;fontStyle=1;"><mxGeometry as="geometry" x="55" y="20" width="900" height="56" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="Nhập thông tin, loại việc, hạn và giờ ước&lt;br&gt;tính" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="97.0" width="360" height="86" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="Biểu mẫu hợp lệ?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="Muốn thêm việc con ngay?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="Nhập việc con, giờ, hạn và người nhận" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Chọn người nhận, mô phỏng tải nếu cần" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="Xác nhận lưu?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="n6" parent="1" vertex="1" value="Trong giao dịch: quyền và&lt;br&gt;người nhận còn hợp lệ, hạn&lt;br&gt;và tổng giờ đều đúng?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="877.0" width="360" height="86" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="Lưu toàn bộ việc và phân công; báo người&lt;br&gt;nhận. Cha nhiều công đoạn chưa có con&lt;br&gt;hiển thị Cần chia nhỏ" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="1007.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Sửa biểu mẫu" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Có thể chia nhỏ sau khi lưu, trước lúc&lt;br&gt;bắt đầu" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b5" parent="1" vertex="1" value="Bỏ biểu mẫu, không tạo dữ liệu." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="b6" parent="1" vertex="1" value="Hủy giao dịch, ghi TASK_CREATE_FAIL; giữ&lt;br&gt;biểu mẫu để sửa" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="877.0" width="360" height="86" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e18" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="448" width="100" height="21" /></mxCell><mxCell id="e20" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e21" edge="1" parent="1" source="n4" target="n5" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22" edge="1" parent="1" source="n5" target="n6" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22l" parent="1" vertex="1" value="Có" style="text;