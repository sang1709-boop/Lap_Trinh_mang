l><mxCell id="e32l" parent="1" vertex="1" value="Hủy" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="763" width="100" height="21" /></mxCell><mxCell id="e34" edge="1" parent="1" source="n6" target="b6" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e34l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="893" width="100" height="21" /></mxCell><mxCell id="e36" edge="1" parent="1" source="b6" target="n0" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1023" y="920" /><mxPoint x="1023" y="82" /><mxPoint x="345" y="82" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="LĐ - Thực hiện công việc" id="wf4"><mxGraphModel pageWidth="1080" pageHeight="1435" page="1" pageScale="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Thực hiện công việc" style="text;align=left;fontSize=28;fontStyle=1;"><mxGeometry as="geometry" x="55" y="20" width="900" height="56" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="Người dùng mở việc và yêu cầu bắt đầu /&lt;br&gt;tiếp tục" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="97.0" width="360" height="86" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="Phiên, nhóm, lượt giao và&lt;br&gt;người phụ trách hiện tại đều&lt;br&gt;đúng?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="Việc và đường lên gốc đều&lt;br&gt;không ẩn, không hủy, không&lt;br&gt;hoàn thành?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="Việc nhiều công đoạn đang&lt;br&gt;thiếu con hợp lệ?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Kiểm lại điều kiện trong giao dịch: bắt&lt;br&gt;đầu tổ tiên cần thiết rồi việc đích, ghi&lt;br&gt;log và báo người bị ảnh hưởng" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="Đây là việc lá?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="n6" parent="1" vertex="1" value="Nộp / xem kết quả theo lưu đồ Duyệt minh&lt;br&gt;chứng" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="877.0" width="360" height="86" /></mxCell><mxCell id="n7" parent="1" vertex="1" value="Bản mới nhất của lượt giao&lt;br&gt;hiện tại Đạt?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="1007.0" width="360" height="86" /></mxCell><mxCell id="n8" parent="1" vertex="1" value="Người phụ trách xác nhận; kiểm lại trạng&lt;br&gt;thái, lượt giao và phiên bản khi đóng" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="1137.0" width="360" height="86" /></mxCell><mxCell id="n9" parent="1" vertex="1" value="Ghi kết quả; báo trưởng nhóm và chủ cha&lt;br&gt;nếu đủ điều kiện đóng" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="1267.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Không thay đổi, ghi TASK_STATUS_DENIED." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Từ chối trước khi ghi, ghi&lt;br&gt;TASK_STATUS_DENIED." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b3" parent="1" vertex="1" value="Chặn bắt đầu; thêm việc con hợp lệ rồi&lt;br&gt;thử lại." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="b5" parent="1" vertex="1" value="Theo quy trình Đóng việc cha." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="b7" parent="1" vertex="1" value="Giữ Đang thực hiện; xem lý do hoặc chờ&lt;br&gt;chấm." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="1007.0" width="360" height="86" /></mxCell><mxCell id="e18" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e19" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e19l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e21" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e21l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="448" width="100" height="21" /></mxCell><mxCell id="e23" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e23l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="578" width="100" height="21" /></mxCell><mxCell id="e25" edge="1" parent="1" source="n4" target="n5" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e26" edge="1" parent="1" source="n5" target="n6" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e26l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="838" width="100" height="21" /></mxCell><mxCell id="e28" edge="1" parent="1" source="n6" target="n7" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e29" edge="1" parent="1" source="n7" target="n8" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e29l" parent="1" vertex="1" value="Đạt" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="1098" width="100" height="21" /></mxCell><mxCell id="e31" edge="1" parent="1" source="n8" target="n9" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e32" edge="1" parent="1" source="n1" target="b1" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e32l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="243" width="100" height="21" /></mxCell><mxCell id="e34" edge="1" parent="1" source="n2" target="b2" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e34l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="373" width="100" height="21" /></mxCell><mxCell id="e36" edge="1" parent="1" source="n3" target="b3" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e36l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="503" width="100" height="21" /></mxCell><mxCell id="e38" edge="1" parent="1" source="n5" target="b5" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e38l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="763" width="100" height="21" /></mxCell><mxCell id="e40" edge="1" parent="1" source="n7" target="b7" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e40l" parent="1" vertex="1" value="Chưa" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="1023" width="100" height="21" /></mxCell></root></mxGraphModel></diagram><diagram name="LĐ - Đóng việc cha" id="wf5"><mxGraphModel pageWidth="1080" pageHeight="785" page="1" pageScale="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Đóng việc cha" style="text;align=left;fontSize=28;fontStyle=1;"><mxGeometry as="geometry" x="55" y="20" width="900" height="56" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="Mở việc cha và đọc con trực tiếp" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="97.0" width="360" height="86" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="Cha còn mở?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="Có con chưa hủy, chưa ẩn?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="Mọi con đó đã hoàn thành?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Người phụ trách đóng cha; ghi lịch sử,&lt;br&gt;báo trưởng nhóm" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Đã đóng, hủy hoặc ẩn. Kết thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Chuyển trưởng nhóm xử lý hủy cha; không&lt;br&gt;ghi hoàn thành. Kết thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b3" parent="1" vertex="1" value="Hiển thị con chưa xong; chưa cho đóng.&lt;br&gt;Kết thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="e11" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e14" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e14l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="448" width="100" height="21" /></mxCell><mxCell id="e16" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="578" width="100" height="21" /></mxCell><mxCell id="e18" edge="1" parent="1" source="n1" target="b1" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="243" width="100" height="21" /></mxCell><mxCell id="e20" edge="1" parent="1" source="n2" target="b2" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e20l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="373" width="100" height="21" /></mxCell><mxCell id="e22" edge="1" parent="1" source="n3" target="b3" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="503" width="100" height="21" /></mxCell></root></mxGraphModel></diagram><diagram name="LĐ - Duyệt minh chứng" id="wf6"><mxGraphModel pageWidth="1080" pageHeight="1045" page="1" pageScale="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Duyệt minh chứng" style="text;align=left;fontSize=28;fontStyle=1;"><mxGeometry as="geometry" x="55" y="20" width="900" height="56" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="Nộp phiên bản mới cho việc lá đang thực&lt;br&gt;hiện" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="97.0" width="360" height="86" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="Tệp đúng loại, số lượng và&lt;br&gt;dung lượng?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="Thông báo trưởng nhóm; minh chứng Chờ&lt;br&gt;chấm" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="Đúng trưởng nhóm và đã xác&lt;br&gt;nhận cảnh báo nếu tự duyệt?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Việc còn mở, đúng phân công&lt;br&gt;và phiên bản hiện hành?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="Nội dung đạt yêu cầu?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="n6" parent="1" vertex="1" value="Ghi Đạt; nếu tự duyệt thì gắn nhãn và báo&lt;br&gt;nhóm. Mở quyền hoàn thành" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="877.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Từ chối tệp và báo lỗi. Kết thúc lần nộp." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b3" parent="1" vertex="1" value="Sai quyền: từ chối. Thiếu xác nhận tự&lt;br&gt;duyệt: giữ Chờ chấm. Kết thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="b4" parent="1" vertex="1" value="Từ chối bản cũ, việc hủy hoặc đã bàn&lt;br&gt;giao. Kết thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="b5" parent="1" vertex="1" value="Trả lại kèm lý do; ghi log nếu tự duyệt.&lt;br&gt;Báo người nộp. Kết thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="e14" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e17" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="578" width="100" height="21" /></mxCell><mxCell id="e20" edge="1" parent="1" source="n4" target="n5" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e20l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="708" width="100" height="21" /></mxCell><mxCell id="e22" edge="1" parent="1" source="n5" target="n6" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="838" width="100" height="21" /></mxCell><mxCell id="e24" edge="1" parent="1" source="n1" target="b1" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0