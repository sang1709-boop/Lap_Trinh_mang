align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="1023" width="100" height="21" /></mxCell></root></mxGraphModel></diagram><diagram name="LĐ - Hiệu lực và phản hồi lời mời" id="wf2"><mxGraphModel pageWidth="1080" pageHeight="1045" page="1" pageScale="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Hiệu lực và phản hồi lời mời" style="text;align=left;fontSize=28;fontStyle=1;"><mxGeometry as="geometry" x="55" y="20" width="900" height="56" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="Kích hoạt từ lịch hoặc phản hồi của người&lt;br&gt;nhận" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="97.0" width="360" height="86" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="Lời mời Chờ phản hồi đã hết&lt;br&gt;hạn?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="Có phản hồi đúng người và&lt;br&gt;nhóm còn hoạt động?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="Người nhận đã thuộc nhóm?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Người nhận chấp nhận và&lt;br&gt;không bị chặn?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="QT-08: ghi tư cách duy nhất, chốt lời&lt;br&gt;mời, đóng yêu cầu chờ cùng nhóm" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="n6" parent="1" vertex="1" value="Ghi INVITE_ACCEPT và báo trưởng nhóm sau&lt;br&gt;giao dịch" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="877.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Đánh dấu Hết hạn một lần, ghi&lt;br&gt;INVITE_EXPIRE; báo trưởng nhóm." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Không thay đổi tư cách; từ chối phản hồi&lt;br&gt;sai phạm vi." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b3" parent="1" vertex="1" value="Đóng lời mời và yêu cầu còn chờ, trả Đã&lt;br&gt;gia nhập; không tạo thành viên trùng." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="b4" parent="1" vertex="1" value="Từ chối hoặc báo bị chặn; nếu từ chối,&lt;br&gt;ghi INVITE_REJECT và báo trưởng nhóm." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="e14" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15l" pare