ry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Người dùng có thể xin vào hoặc nhận lời&lt;br&gt;mời mới; không tự gia nhập" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Từ chối và ghi MEMBER_UNBLOCK_FAIL. Kết&lt;br&gt;thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Giữ nguyên danh sách chặn. Kết thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="e10" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e13" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="448" width="100" height="21" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1