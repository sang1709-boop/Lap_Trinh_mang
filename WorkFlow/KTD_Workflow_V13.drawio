" /></mxCell><mxCell id="n0" parent="1" vertex="1" value="Nhập hồ sơ và kiểm tra định dạng" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="97.0" width="360" height="86" /></mxCell><mxCell id="n1" parent="1" vertex="1" value="MSSV khớp email trường trong&lt;br&gt;danh mục khoa?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="n2" parent="1" vertex="1" value="Chưa có tài khoản đã kích&lt;br&gt;hoạt?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="Gửi OTP theo QT-06; hồ sơ chờ tối đa 24&lt;br&gt;giờ, chưa độc quyền MSSV/email" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="OTP hợp lệ và hồ sơ còn hạn?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="Kiểm lại duy nhất; kích hoạt đúng một tài&lt;br&gt;khoản, hủy yêu cầu chờ cạnh tranh" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Không tạo giữ chỗ. Trả mã đối soát; khoa&lt;br&gt;kiểm tra và sửa nguồn trước khi thử lại." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Không tạo trùng; hướng dẫn khôi phục tài&lt;br&gt;khoản." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b4" parent="1" vertex="1" value="Từ chối mã, áp dụng giới hạn QT-06; hết&lt;br&gt;24 giờ thì đăng ký lại." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="e12" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="448" width="100" height="21" /></mxCell><mxCell id="e17" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18" edge="1" parent="1" source="n4" target="n5" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="708" width="100" height="21" /></mxCell><mxCell id="e20" edg