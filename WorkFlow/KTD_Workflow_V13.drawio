hiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Đúng mật khẩu, nguồn không&lt;br&gt;bị chặn?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="Email đã xác minh?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="n6" parent="1" vertex="1" value="Cấp token riêng theo QT-07, đặt lại số&lt;br&gt;lần sai và ghi LOGIN" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="877.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Sang Khôi phục mật khẩu." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Hủy hồ sơ tạm, ghi hết hạn; trả lỗi chung&lt;br&gt;với cùng liên kết đăng ký lại." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b4" parent="1" vertex="1" value="Trả lỗi chung; giới hạn IP, khóa cặp tài&lt;br&gt;khoản–nguồn khi đủ 5 lần sai." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="b5" parent="1" vertex="1" value="Đúng mật khẩu: chuyển xác minh, gửi lại&lt;br&gt;theo QT-06." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="e14" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e17" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e17l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="448" width="100" height="21" /></mxCell><mxCell id="e19" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e20" edge="1" parent="1" source="n4" target="n5" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e20l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="708" width="100" height="21" /></mxCell><mxCell id="e22" edge="1" parent="1" source="n5" target="n6" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e22l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="838" width="100" height="21" /></mxCell><mxCell id="e24" edge="1" parent="1" source="n1" target="b1" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.