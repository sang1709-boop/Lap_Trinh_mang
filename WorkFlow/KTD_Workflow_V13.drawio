x="1" value="Kiểm hạn mới của cha và tổ tiên từ gốc&lt;br&gt;xuống. Lưu đồng thời và giữ mốc D10 cũ" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="Ghi TASK_UPDATE cho từng cấp; báo các chủ&lt;br&gt;việc" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Từ chối, ghi TASK_UPDATE_DENIED. Kết&lt;br&gt;thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Liệt kê con còn mở. Xác nhận hủy vĩnh&lt;br&gt;viễn kèm lý do mới lưu và báo người nhận." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b3" parent="1" vertex="1" value="Báo lỗi và ghi TASK_UPDATE_DENIED. Kết&lt;br&gt;thúc." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="e12" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n2"