metry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="e10" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" edge="1" parent="1" source="n1" target="n2" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="318" width="100" height="21" /></mxCell><mxCell id="e13" edge="1" parent="1" source="n2" target="n3" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13l" parent="1" vertex="1" value="Có" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="388" y="448" width="100" height="21" /></mxCell><mxCell id="e15" edge="1" parent="1" source="n3" target="n4" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16" edge="1" parent="1" source="n1" target="b1" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="243" width="100" height="21" /></mxCell><mxCell id="e18" edge="1" parent="1" source="n2" target="b2" style="edgeStyle=none;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18l" parent="1" vertex="1" value="Không" style="text;align=center;fontSize=13;"><mxGeometry as="geometry" x="520" y="373" width="100" height="21" /></mxCell></root></mxGraphModel></diagram><diagram name="LĐ - Ghi nhật ký hoạt động" id="wf20"><mxGraphModel pageWidth="10