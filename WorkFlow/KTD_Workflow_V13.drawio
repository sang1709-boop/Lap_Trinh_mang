ex="1" value="Người rời còn việc mở?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="n3" parent="1" vertex="1" value="Xác nhận thao tác" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="487.0" width="360" height="86" /></mxCell><mxCell id="n4" parent="1" vertex="1" value="Khi ghi: quyền còn đúng và&lt;br&gt;không phát sinh việc mở?" style="rhombus;html=1;whiteSpace=wrap;fontSize=14;fillColor=#FFF2CC;strokeColor=#A17C32;"><mxGeometry as="geometry" x="165.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="n5" parent="1" vertex="1" value="Đổi tư cách; nếu xóa, chặn gia nhập và&lt;br&gt;thu hồi lời mời. Báo người liên quan" style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="165.0" y="747.0" width="360" height="86" /></mxCell><mxCell id="b1" parent="1" vertex="1" value="Dừng, hiển thị lý do hoặc bàn giao vai&lt;br&gt;trò." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="227.0" width="360" height="86" /></mxCell><mxCell id="b2" parent="1" vertex="1" value="Hoàn thành, hủy hợp lệ hoặc bàn giao&lt;br&gt;trước khi thử lại." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="357.0" width="360" height="86" /></mxCell><mxCell id="b4" parent="1" vertex="1" value="Hủy giao dịch, báo lý do và giữ tư cách&lt;br&gt;thành viên." style="rounded=1;html=1;whiteSpace=wrap;fontSize=16;fillColor=#EAF3F9;strokeColor=#527792;"><mxGeometry as="geometry" x="615.0" y="617.0" width="360" height="86" /></mxCell><mxCell id="e12" edge="1" parent="1" source="n0" target="n1" style="edgeStyle=none;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=